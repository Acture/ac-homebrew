<Project Sdk="Microsoft.NET.Sdk">

  <!-- AC's Homebrew (UMM Id AttributeFeats) mechanics tests on the WotR.Testing.Offline package: real game assemblies and blueprints, no game process. -->
  <Import Project="$(ACHomebrewRepositoryRoot)GamePath.props" Condition="Exists('$(ACHomebrewRepositoryRoot)GamePath.props')" />

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

    <WotrModAssembly>$(ACHomebrewRepositoryRoot)artifacts/bin/ACHomebrew/$(Configuration)/ACHomebrew.dll</WotrModAssembly>
    <WotrSnapshotDirectory>$(ACHomebrewRepositoryRoot)vendor/wotr</WotrSnapshotDirectory>
    <!-- Short on purpose: the game's Mono cannot open paths over 260 characters, and the runtime cache adds up to 126. -->
    <WotrWorkDirectory>$(ACHomebrewRepositoryRoot)artifacts/wotr/</WotrWorkDirectory>
    <WotrReportDirectory>$(ACHomebrewRepositoryRoot)artifacts/test-results/offline-mechanics/</WotrReportDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WotR.Testing.Offline" Version="0.1.0-preview.1" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" PrivateAssets="all" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.4.13" />
  </ItemGroup>

  <ItemGroup>
    <!-- Build the mod from source first, without deploying it, against the same game inputs. -->
    <ProjectReference Include="../../src/ACHomebrew/ACHomebrew.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false"
                      AdditionalProperties="DeployMod=false;WrathInstallDir=$(WotrInputRoot)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>