<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Microsoft.CodeAnalysis" HintPath="$(MSBuildSDKsPath)/../Roslyn/bincore/Microsoft.CodeAnalysis.dll" />
    <Reference Include="Microsoft.CodeAnalysis.CSharp" HintPath="$(MSBuildSDKsPath)/../Roslyn/bincore/Microsoft.CodeAnalysis.CSharp.dll" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <Compile Include="../../src/ACHomebrew.Core/FeatTextCatalog.cs" Link="FeatTextCatalog.cs" />
    <Compile Include="../../src/ACHomebrew.Core/Common.Localization.cs" Link="Common.Localization.cs" />
    <Compile Include="../../src/ACHomebrew.Core/TextFormat.cs" Link="TextFormat.cs" />
    <EmbeddedResource Include="../../src/ACHomebrew.Core/Localization/enGB.json" LogicalName="AttributeFeats.Localization.FeatText.json" />
    <EmbeddedResource Include="../../src/ACHomebrew.Core/Localization/zhCN.json" LogicalName="AttributeFeats.Localization.zhCN.json" />
  </ItemGroup>
</Project>
